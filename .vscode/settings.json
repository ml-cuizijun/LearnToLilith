{
  // 阅读用顶部 Preview | Markdown（TipTap：Mermaid + 全宽 + 红标题）。
  // 样式注入：bash .vscode/apply-cursor-preview-red.sh（Cursor 更新后需重跑 + Cmd+Q）
  // 集群架构 Preview 异常：Cmd+Q 后 bash .vscode/fix-cluster-preview.sh
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 6,
  "outline.collapseItems": "alwaysExpand",
  "window.title": "LearnToLilith — ${activeEditorShort}${separator}${rootName}",
  "markdown.styles": [
    ".vscode/markdown-preview.css"
  ],
  "markdown.preview.breaks": true,
  "markdown.preview.doubleClickToSwitchToEditor": true,
  // 全宽+红标题：bash .vscode/apply-cursor-preview-red.sh 后 Cmd+Q 重启
}
